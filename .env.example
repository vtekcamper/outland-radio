# Spotify App credentials — crea l'app su https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=il_tuo_client_id
SPOTIFY_CLIENT_SECRET=il_tuo_client_secret

# URL di callback — deve corrispondere esattamente a quello impostato nell'app Spotify
# In sviluppo:  http://localhost:5000/callback
# In produzione: https://tuo-progetto.up.railway.app/callback
SPOTIFY_REDIRECT_URI=http://localhost:5000/callback

# Sicurezza Flask (stringa casuale lunga)
FLASK_SECRET_KEY=cambia_questa_stringa_con_qualcosa_di_lungo_e_casuale

# Password per accedere al pannello admin
ADMIN_PASSWORD=outland2024

# Dopo il primo login con Spotify, incolla qui il refresh token
# (opzionale: permette di sopravvivere ai redeploy se il volume non è configurato)
# SPOTIFY_REFRESH_TOKEN=

# Directory dati persistenti — corrisponde al Railway Volume mount path
# In sviluppo locale puoi usare una cartella locale es. ./data
DATA_DIR=/programmatic-seo
